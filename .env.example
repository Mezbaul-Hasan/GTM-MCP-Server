# gtm-mcp — every variable is OPTIONAL.
# Normal use needs none of them: run `gtm-mcp auth` (or `gtm-mcp auth --with-writes`) once and the refresh
# token is stored in ~/.gtm-mcp/config.json (readable only by you). Never commit a real .env file.

# --- Credentials override (multi-account, CI, or when you do not want a config file) -------------
# If ALL THREE are set they are used instead of ~/.gtm-mcp/config.json.
# Client id/secret = a Google Cloud OAuth client of type "Desktop app" (the same one ga4-mcp uses is fine).
# Refresh token    = obtained by `gtm-mcp auth`. GOOGLE_SCOPES tells the server which profile that token has.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_SCOPES=

# --- Where config.json and audit.jsonl live (default: ~/.gtm-mcp) --------------------------------
# Use a different folder per Google account to switch accounts: GTM_MCP_CONFIG_DIR=~/.gtm-mcp-client-x
GTM_MCP_CONFIG_DIR=

# --- Local audit log of every tool call (default: enabled, ~/.gtm-mcp/audit.jsonl). 1 = disable. ----
GTM_MCP_AUDIT_DISABLED=

# --- Client-side request rate. Google's limit is 25 requests / 100 s per Cloud project (= 0.25). ----
GTM_MCP_RATE_LIMIT_QPS=0.25

# --- Log verbosity on stderr (DEBUG | INFO | WARNING). Logs never contain tokens or payloads. ------
MCP_LOG_LEVEL=INFO
